SECRET_KEY=troque-por-uma-frase-longa-e-secreta
# DEMO=1 cria dados de exemplo quando o banco está vazio
DEMO=1
# Sem DATABASE_URL usa SQLite local (arquivo instance/controle.db)
# DATABASE_URL=postgresql://usuario:senha@host/banco
# Fuso horário do aeroclube (o servidor pode estar em outro país)
FUSO_HORARIO=America/Sao_Paulo

# E-mail dos avisos de vencimento. Sem SMTP_HOST, os avisos são só simulados.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORTA=587
# SMTP_USUARIO=seu-email@gmail.com
# SMTP_SENHA=senha-de-app
# EMAIL_REMETENTE=seu-email@gmail.com

# Senha que o agendador diário usa para pedir o envio (ver .github/workflows/avisos.yml)
# AVISOS_TOKEN=uma-frase-longa-e-aleatoria
